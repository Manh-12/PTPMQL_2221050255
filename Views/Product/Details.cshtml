@model PTPMQL_MVC.Models.Product

@{
    ViewData["Title"] = "Chi tiết sản phẩm";
}

<div class="container py-4">

    <div class="row justify-content-center">

        <div class="col-md-7">

            <div class="card shadow-sm">

                <div class="card-header">
                    <h4 class="mb-0">Chi tiết sản phẩm</h4>
                </div>

                <div class="card-body">

                    <dl class="row">

                        <dt class="col-sm-4">
                            ID
                        </dt>

                        <dd class="col-sm-8">
                            @Model.Id
                        </dd>

                        <dt class="col-sm-4">
                            Tên sản phẩm
                        </dt>

                        <dd class="col-sm-8">
                            @Model.Name
                        </dd>

                        <dt class="col-sm-4">
                            Giá
                        </dt>

                        <dd class="col-sm-8">
                            @Model.Price.ToString("N0") VNĐ
                        </dd>

                        <dt class="col-sm-4">
                            Số lượng
                        </dt>

                        <dd class="col-sm-8">
                            @Model.Quantity
                        </dd>

                        <dt class="col-sm-4">
                            Mô tả
                        </dt>

                        <dd class="col-sm-8">
                            @Model.Description
                        </dd>

                    </dl>

                    <div class="d-flex gap-2">

                        <a asp-action="Edit"
                           asp-route-id="@Model.Id"
                           class="btn btn-warning">
                            Sửa
                        </a>

                        <a asp-action="Index"
                           class="btn btn-secondary">
                            Quay lại
                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>