
@model PTPMQL_MVC.Models.Student

@{
    ViewData["Title"] = "Kết quả thêm sinh viên";
}

<div class="container mt-5">

    <div class="card shadow border-0">

        <div class="card-header bg-success text-white p-3">
            <h4 class="mb-0">
                Thêm sinh viên thành công!
            </h4>
        </div>

        <div class="card-body p-4">

            <div class="alert alert-success">
                Sinh viên đã được lưu vào hệ thống.
            </div>

            <table class="table table-bordered">

                <tr>
                    <th>Mã sinh viên</th>
                    <td>@Model.StudentId</td>
                </tr>

                <tr>
                    <th>Họ và tên</th>
                    <td>@Model.FullName</td>
                </tr>

                <tr>
                    <th>Địa chỉ</th>
                    <td>@Model.Address</td>
                </tr>

                <tr>
                    <th>Năm tuyển sinh</th>
                    <td>@Model.AdmissionYear</td>
                </tr>

                <tr>
                    <th>Mã hệ đào tạo</th>
                    <td>@Model.SystemCode</td>
                </tr>

                <tr>
                    <th>Mã ngành</th>
                    <td>@Model.MajorCode</td>
                </tr>

            </table>

            <a asp-controller="Student"
               asp-action="Index"
               class="btn btn-primary">
                Quay lại danh sách
            </a>

            <a asp-controller="Student"
               asp-action="Create"
               class="btn btn-success">
                Thêm sinh viên khác
            </a>

        </div>
    </div>
</div>
