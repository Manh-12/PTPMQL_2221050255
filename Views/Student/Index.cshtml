
@model IEnumerable<PTPMQL_MVC.Models.Student>

@{
    ViewData["Title"] = "Quản lý sinh viên";
    var students = Model ?? Enumerable.Empty<PTPMQL_MVC.Models.Student>();
    var currentPage = (int)ViewBag.Page;
    var pageSize = (int)ViewBag.PageSize;
    var totalCount = (int)ViewBag.TotalCount;
    var totalPages = (int)ViewBag.TotalPages;
    var firstItem = totalCount == 0 ? 0 : (currentPage - 1) * pageSize + 1;
    var lastItem = Math.Min(currentPage * pageSize, totalCount);
    var startPage = Math.Max(1, currentPage - 2);
    var endPage = Math.Min(totalPages, startPage + 4);
    startPage = Math.Max(1, endPage - 4);
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Quản lý sinh viên</h2>
            <p class="text-muted mb-0">
                Quản lý thông tin sinh viên trong hệ thống
            </p>
        </div>

        <button type="button"
                class="btn btn-primary"
                data-student-create-url="@Url.Action("Create", new { modal = true })"
                data-bs-toggle="modal"
                data-bs-target="#studentModal">
            + Thêm sinh viên
        </button>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <form method="get" asp-action="Index" class="row g-2 align-items-end">
                <input type="hidden" name="page" value="1" />

                <div class="col-md-7">
                    <input class="form-control"
                           type="text"
                           name="keyword"
                           value="@ViewBag.Keyword"
                           placeholder="Nhập mã hoặc tên sinh viên cần tìm..." />
                </div>

                <div class="col-md-3">
                    <label for="pageSize" class="form-label">Số sinh viên mỗi trang</label>
                    <select class="form-select" id="pageSize" name="pageSize" onchange="this.form.submit()">
                        <option value="10" selected="@(pageSize == 10)">10</option>
                        <option value="20" selected="@(pageSize == 20)">20</option>
                        <option value="50" selected="@(pageSize == 50)">50</option>
                    </select>
                </div>

                <div class="col-md-2 d-grid">
                    <button type="submit"
                            class="btn btn-outline-primary">
                        <i class="bi bi-search"></i>
                        Tìm kiếm
                    </button>
                </div>

            </form>

        </div>
    </div>

    <div class="card shadow-sm">

        <div class="card-header bg-white py-3">
            <strong>Danh sách sinh viên</strong>
            <span class="badge bg-primary ms-2" id="studentCountBadge">
                @totalCount
            </span>
        </div>

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-bordered table-hover align-middle mb-0">

                    <thead class="table-dark">
                        <tr>
                            <th>Mã sinh viên</th>
                            <th>Họ tên</th>
                            <th>Ngành</th>
                            <th>Khoa</th>
                            <th>Hệ đào tạo</th>
                            <th>Địa chỉ</th>
                            <th class="text-center">Thao tác</th>
                        </tr>
                    </thead>

                    <tbody id="studentTableBody">

                        @if (!students.Any())
                        {
                            <tr>
                                <td colspan="7"
                                    class="text-center text-muted py-5">
                                    Không tìm thấy sinh viên nào.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var s in students)
                            {
                                <tr>

                                    <td class="fw-semibold">
                                        @(s?.StudentId ?? "Chưa có mã")
                                    </td>

                                    <td>
                                        @(s?.FullName ?? "Chưa cập nhật")
                                    </td>

                                    <td>
                                        @(s?.Major?.MajorName ?? "Chưa cập nhật")
                                    </td>

                                    <td>
                                        @(s?.Major?.Faculty?.FacultyName ?? "Chưa cập nhật")
                                    </td>

                                    <td>
                                        @(s?.TrainingSystem?.SystemName ?? "Chưa cập nhật")
                                    </td>

                                    <td>
                                        @(s?.Address ?? "Chưa cập nhật")
                                    </td>

                                    <td class="text-center">

                                        <a class="btn btn-sm btn-warning mb-1"
                                           asp-action="Edit"
                                           asp-route-id="@s?.StudentId">
                                            Sửa
                                        </a>

                                        <form asp-action="Delete"
                                              asp-route-id="@s?.StudentId"
                                              method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('Bạn có chắc muốn xóa sinh viên này?')">

                                            <button type="submit"
                                                    class="btn btn-sm btn-danger mb-1">
                                                Xóa
                                            </button>

                                        </form>

                                    </td>

                                </tr>
                            }
                        }

                    </tbody>

                </table>

            </div>

        </div>
    </div>

    <div class="mt-3 text-muted small">
        Hiển thị @firstItem–@lastItem trong tổng số
        <span id="studentTotalCount">@totalCount</span> sinh viên.
        Trang @currentPage / @totalPages.
    </div>

    <nav class="mt-3" aria-label="Phân trang sinh viên">
        <ul class="pagination flex-wrap">
            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-keyword="@ViewBag.Keyword"
                   asp-route-page="1" asp-route-pageSize="@pageSize" aria-label="Trang đầu">Đầu</a>
            </li>
            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-keyword="@ViewBag.Keyword"
                   asp-route-page="@(currentPage - 1)" asp-route-pageSize="@pageSize" aria-label="Trang trước">Trước</a>
            </li>
            @for (var pageNumber = startPage; pageNumber <= endPage; pageNumber++)
            {
                <li class="page-item @(pageNumber == currentPage ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-keyword="@ViewBag.Keyword"
                       asp-route-page="@pageNumber" asp-route-pageSize="@pageSize">@pageNumber</a>
                </li>
            }
            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-keyword="@ViewBag.Keyword"
                   asp-route-page="@(currentPage + 1)" asp-route-pageSize="@pageSize" aria-label="Trang tiếp">Sau</a>
            </li>
            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-keyword="@ViewBag.Keyword"
                   asp-route-page="@totalPages" asp-route-pageSize="@pageSize" aria-label="Trang cuối">Cuối</a>
            </li>
        </ul>
    </nav>

</div>

<div class="modal fade" id="studentModal" tabindex="-1" aria-labelledby="studentModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title fs-5" id="studentModalTitle">Thêm sinh viên mới</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body" id="studentModalBody">
                <div class="d-flex justify-content-center py-4">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Đang tải...</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="toast-container position-fixed bottom-0 end-0 p-3">
    <div id="studentToast" class="toast" role="status" aria-live="polite" aria-atomic="true">
        <div class="toast-header">
            <strong class="me-auto">Quản lý sinh viên</strong>
            <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Đóng"></button>
        </div>
        <div class="toast-body" id="studentToastMessage"></div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
